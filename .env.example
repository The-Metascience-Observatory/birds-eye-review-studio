# Bird's Eye Review pipeline — environment variables.
#
# Copy to .env.local (ignored by version control), then UNCOMMENT and fill in
# what you use (an empty assignment is not always the same as unset). Every pipeline
# step script loads .env.local from the repo root; a variable already exported in
# your shell wins over the file. Nothing here is required to run the pipeline
# end to end except EMAIL (for PubMed / Crossref) and an LLM provider login.
#
# Keys sent as URL query parameters (OpenAlex, NCBI) are redacted from every
# log line the pipeline writes.

# --- Contact address ------------------------------------------------------------
# NCBI E-utilities (PubMed search, abstracts, PMID->DOI) and Crossref require a
# contact e-mail with every request; PubMed runs refuse to start without it.
# Also used for OpenAlex's polite pool and by fetchpdf (Unpaywall).
EMAIL=
# Contact address for metadata enrichment's polite pools; falls back to EMAIL.
# CONTACT_EMAIL=
# Crossref "mailto" for metadata enrichment specifically (optional).
# CROSSREFEMAIL=

# --- Literature APIs (all optional; higher rate limits / more sources) ----------
# NCBI E-utilities key (10 req/s instead of 3). Note the exact name.
# ENTREZ_EUTILS_API_KEY=
# OpenAlex premium key. NO underscores in the name.
# OPENALEXAPIKEY=
# SEMANTIC_SCHOLAR_API_KEY=
# Elsevier Scopus (metadata enrichment).
# SCOPUS_API_KEY=
# Dimensions.ai (metadata enrichment).
# DIMENSIONS_API_KEY=
# Crossref Plus token (metadata enrichment).
# CROSSREF_API_KEY=
# CORE (core.ac.uk): PDF download via fetchpdf, and opt-in metadata
# (steps/enrich_metadata.py --enable-core). NO underscores in the name. Trial keys
# expire after about a month.
# COREAPIKEY=
# PubPeer API key for the INSPECT-SR integrity checks (optional).
# PUBPEER_DEVKEY=
# Read by fetchpdf (not by this repo) for Elsevier full-text downloads.
# ELSEVIER_TDM_API_KEY=

# --- LLM provider ----------------------------------------------------------------
# Which backend answers model calls: codex_cli (default; the host's `codex login`),
# claude_cli (the host's `claude` login), claude_token, anthropic_key, openrouter.
# BER_LLM_PROVIDER=
# Codex effort per process: low, medium (default), or high.
# Use low for initial screening; keep medium for detailed extraction.
# BER_CODEX_REASONING_EFFORT=medium
# OpenRouter key, when BER_LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=
# Optional OpenRouter attribution header (your site URL). Not sent when empty.
# BER_OPENROUTER_REFERER=
# Completion-token ceiling for OpenRouter calls (default 32000).
# BER_OPENROUTER_MAX_TOKENS=
# Map a CLI model alias to an OpenRouter slug, e.g.
# BER_OPENROUTER_MODEL_SONNET=anthropic/claude-sonnet-4
# For claude_token / anthropic_key the credential is CLAUDE_CODE_OAUTH_TOKEN /
# ANTHROPIC_API_KEY. Do NOT put either in .env.local on a studio host: it would
# outrank every user's own credential (see CLAUDE.md, "LLM credentials").

# --- Claude CLI usage guard (BER_LLM_PROVIDER=claude_cli) ------------------------
# Pauses a run when the 5-hour session reaches the threshold; stops it (exit 3)
# past the weekly ceiling. BER_USAGE_GUARD=0 disables it.
# BER_USAGE_GUARD=
# BER_USAGE_THRESHOLD=   # session %, default 80
# BER_USAGE_WEEK_THRESHOLD=   # weekly %, default 95
# BER_USAGE_WEEK_THRESHOLD_HAIKU=   # weekly % for haiku calls, default 95
# BER_USAGE_INTERVAL_MIN=   # minutes between probes, default 25
# BER_USAGE_POLL_MIN=   # minutes between re-checks while paused, default 15

# --- Paths -----------------------------------------------------------------------
# Where projects/<slug>/ live (default: <repo>/projects).
# BER_PROJECTS_DIR=
# A directory of prompt overrides (<dir>/<slug>/<name>.txt or <dir>/<name>.txt).
# BER_PROMPTS_DIR=
# Local SciSciNet snapshot for offline abstracts/metadata (optional), and
# BER_SCISCINET_WRITE=1 to write API results back into it.
# BER_SCISCINET_DIR=
# BER_SCISCINET_WRITE=

# --- PDF conversion ----------------------------------------------------------------
# 1 = let steps/convert_pdfs.py repair a broken docling install itself (at most once).
# BER_FIX_DOCLING=
# Root of a separately installed MinerU runtime, for scripts/mineru_standard_adapter.py
# (see docs/conversion-benchmark.md).
# BER_MINERU_RUNTIME_ROOT=

# --- Set by the studio, never by hand ----------------------------------------------
# BER_MANAGED_RUN=1 marks a studio-managed run: user-supplied dirs.* inputs are
# ignored and provider credentials are enforced. BER_DOCLING_REEXEC marks the
# one permitted docling-repair restart.
