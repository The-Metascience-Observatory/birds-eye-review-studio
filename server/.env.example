# Copy to server/.env and adjust. All values have sane defaults in config.py.

# --- Database ---
# Default (zero-friction local dev): sqlite, relative to repo-root cwd.
DATABASE_URL=sqlite+aiosqlite:///./server/dev.db
# Postgres path (docker-compose provides one, user/password/db all "bird"):
# DATABASE_URL=postgresql+asyncpg://bird:bird@localhost:5432/bird

# --- Auth ---
# config.py ships JWT_SECRET="dev-insecure-change-me". Left at the default,
# ANYONE can forge a token for any user — including role=admin.
# Under PUBLIC_MODE the process REFUSES to start unless this is a random
# value at least 32 characters that is not a documented placeholder:
#   JWT_SECRET=$(openssl rand -hex 32)
# Leave unset for local dev. Changing it later signs everyone out (tokens
# are stateless), which is harmless.
# JWT_SECRET=
JWT_ALGO=HS256
# 30 days locally; PUBLIC_MODE shortens this to 1440 (1 day) unless set.
# ACCESS_TTL_MIN=1440

# --- Secrets at rest ---
# Master key for encrypting stored API keys (crypto.py derives a Fernet key from
# it via HKDF). EMPTY falls back to JWT_SECRET, which is fine for local dev and
# wrong for a real deploy.
#   APP_SECRET=$(openssl rand -hex 32)
# SET THIS BEFORE ANYONE SAVES AN API KEY. Rotating it later makes every
# already-stored key permanently undecryptable — there is no migration path.
APP_SECRET=

# --- Public hosting ---
# ON when this instance is reachable from outside the host (behind a Cloudflare
# tunnel, say). One flag rather than several, because they all answer the same
# question — "can a stranger reach this process?" — and splitting them invites a
# deploy that sets two of the three.
#
#   * /docs, /redoc and /openapi.json are removed.
#   * Unhandled errors return an opaque reference instead of exception text.
#   * Signup FAILS CLOSED: with no invite and no SIGNUP_CODE, registration is
#     refused rather than open.
#   * The password floor rises to PUBLIC_MIN_PASSWORD_LEN (12).
#   * BER_ENGINE_FAKE_STEPS (the test-only arbitrary-script hook) is refused.
#   * Boot refuses a missing/placeholder JWT_SECRET or empty APP_SECRET.
#   * Rate limits, a 1-day token TTL, and no LAN CORS regex apply if unset.
#   * TRUST_PROXY_HEADERS turns on unless explicitly set to false.
#   * Host-shared LLM logins are refused for non-admins (PUBLIC_REQUIRE_BYO_LLM).
#   * Custom PDF folders are disabled; config extra_steps can never run.
#
# Pair it with `./dev.sh up --public` (which also exports this flag so the
# two cannot diverge). See docs/hosting.md.
PUBLIC_MODE=false

# Trust Cloudflare's CF-Connecting-IP for the rate limiter's per-client key
# (X-Forwarded-For is never trusted — its left-most entry is client-supplied).
# Turn ON only when every request genuinely arrives through the tunnel —
# otherwise the header is attacker-controlled and each forged value would get
# its own fresh quota. Unset + PUBLIC_MODE => on. See app/ratelimit.py.
TRUST_PROXY_HEADERS=false

# Under PUBLIC_MODE, refuse the HOST's shared LLM logins (claude_cli,
# codex_cli) for non-admin users: on a hosted instance they bill the operator's
# own subscription. Users bring their own credential in Settings instead.
# PUBLIC_REQUIRE_BYO_LLM=true

# The address the API is served on. dev.sh exports it (127.0.0.1 by default,
# 0.0.0.0 with --lan); the API refuses to start on a non-loopback address while
# JWT_SECRET is the documented placeholder.
# BIND_HOST=127.0.0.1

# Minimum password length at registration. 0 = no policy (dev/test default).
# PUBLIC_MODE raises the floor to PUBLIC_MIN_PASSWORD_LEN automatically, so
# leaving this at 0 is safe.
MIN_PASSWORD_LEN=0

# Largest PDF a user may upload, in MB. The body is buffered, so this is a
# memory bound as much as a disk one.
MAX_UPLOAD_MB=50
# Per-account lifetime caps on hand-uploaded PDFs.
# UPLOAD_MAX_FILES_PER_USER=2000
# UPLOAD_MAX_TOTAL_MB_PER_USER=10000

# --- Signup gating ---
# PREFERRED: per-person access codes, minted with
#   PYTHONPATH=server server/.venv/bin/python server/scripts/manage_access.py \
#       mint --label "collaborator-1"
# or from the studio's /admin/invites page. Each admits one person, records who
# used it, and can be revoked individually — revoking also ends that account's
# session on its next request.
#
# LEGACY fallback: one shared code for everyone. EMPTY = no shared code. With
# PUBLIC_MODE=true, empty is safe (signup fails closed); with PUBLIC_MODE=false,
# empty means anyone who can reach the port gets an account, which is the right
# default for local dev only.
# Rotating a shared code invalidates it for everyone at once, and it records
# nothing about who used it — which is why invites exist.
SIGNUP_CODE=

# --- Rate limiting (per-IP, on /auth/* only) ---
# EMPTY = disabled, which is the right default for local dev. PUBLIC_MODE
# fills in "10/hour" (register) and "10/minute;100/hour" (login) if these
# are left empty. Override here to tighten or loosen. Syntax: "10/hour",
# "5/minute", or several at once with ";".
# RATELIMIT_REGISTER=10/hour
# RATELIMIT_LOGIN=10/minute;100/hour
# Per-USER limits: endpoints that spend LLM money (agent, drafting, runs), and
# saving a Claude credential (each save makes a verifying model call).
# PUBLIC_MODE fills in "20/minute;300/hour" and "5/minute;20/hour".
# RATELIMIT_LLM=20/minute;300/hour
# RATELIMIT_CREDENTIAL=5/minute;20/hour
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Filesystem ---
# Per-review workspaces (gitignored). Default: server/_data
DATA_ROOT=./server/_data
# Root of this pipeline repo (pipeline_bridge imports pipeline/ber_core from here).
REPO_ROOT=.
# A checkout of the website repo that serves published dashboards; publishing
# copies bundles into WEBSITE_DIR/data/birds_eye_reviews/. Unset = this
# instance cannot publish (preflight says so).
# WEBSITE_DIR=/path/to/website-checkout

# The pipeline can run config-declared `extra_steps` scripts. The API never
# accepts them from a client; this lets a WORKSPACE config.yaml an operator
# edited by hand use them. Default off; refused under PUBLIC_MODE.
# ALLOW_CONFIG_EXTRA_STEPS=false

# --- Infra ---
# REQUIRED: both arq workers, the enqueue pool and the rate-limit counters.
# With docker-compose's Redis (which requires a password):
#   REDIS_URL=redis://:bird-local-dev@localhost:6379/0
# Workers: server/.venv/bin/python -m arq server.app.worker.WorkerSettings
#          server/.venv/bin/python -m arq server.app.worker.PdfWorkerSettings
REDIS_URL=redis://localhost:6379/0

# Live log streams: keepalive comment interval and maximum stream lifetime.
# SSE_PING_SECONDS=15
# SSE_MAX_SECONDS=21600

# --- CORS (comma-separated) ---
# Largely moot now: the studio proxies /api to this server from its own origin
# (studio/next.config.mjs), so browser requests are SAME-ORIGIN and never
# preflight. These matter only if someone sets NEXT_PUBLIC_API_BASE to point the
# browser at an absolute API URL, or calls the API from another tool.
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Regex of additionally-allowed CORS origins. The dev default (see config.py)
# allows loopback + all private-LAN ranges (10.x / 172.16-31.x / 192.168.x) on
# any port — 172.16-31.x covers WSL2. Combined with allow_credentials, that
# trusts every origin on the local network. SET IT EMPTY on a public host.
CORS_ORIGIN_REGEX=

# Interpreter for pipeline scripts (needs pipeline deps; NOT the server venv).
# Empty = auto (base python the venv was made from, e.g. /usr/bin/python3).
# PIPELINE_PYTHON=

# --- Local SciSciNet tier (optional) ---
# Directory holding journals.db / abstracts.db / papers_extra.db / mesh.db.
# When set, metadata + abstract lookups read local SQLite before hitting the
# APIs (~82% / ~52% hit rate measured; ~60-100ms vs seconds per paper). Empty
# or missing => the tier is simply off and everything uses the API waterfall.
# SCISCINET_DIR=/data/sciscinet

# Write API results back into those DBs so each paper costs a network fetch at
# most once (the second run over the same corpus is then nearly offline).
# Default false. Also refused automatically on FUSE filesystems, where SQLite
# WAL locking is unreliable — so an external NTFS drive stays read-only even
# with this set. Safe on ext4/NVMe.
# SCISCINET_WRITE=true
