# Studio environment. Copy to .env.local only if you need to change a default.
#
# NOTHING HERE IS REQUIRED. By default the app calls the API at the same-origin
# path /api, which next.config.mjs proxies to the FastAPI server. That is the
# supported setup for both local dev and public hosting.

# Where the Next server forwards /api/* to. SERVER-side only — it is never sent
# to the browser. Change it only if the API listens somewhere other than
# 127.0.0.1:8000.
# BER_API_ORIGIN=http://127.0.0.1:8000

# Escape hatch: make the BROWSER call an absolute API URL instead of /api.
# Setting this opts back into cross-origin requests, so the page's origin must
# then be listed in the server's CORS_ORIGINS. Leave it unset unless you are
# deliberately pointing the app at an API on another host.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
